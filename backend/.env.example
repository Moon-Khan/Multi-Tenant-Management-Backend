# Copy this file to .env for local development. All credentials and secrets
# below are development-only examples. Replace them before any shared or public
# deployment, and never commit the real .env file.

# App
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops to trust for X-Forwarded-For (1 behind a single LB).
TRUST_PROXY=0

# Database — the RUNNING APP connects with this (non-owner, RLS-subject) role.
# These host/port values are for running the backend directly on your machine.
# Docker Compose overrides them with postgres:5432 inside the Compose network.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=multitenant
DB_USERNAME=app_runtime
DB_PASSWORD=app_runtime_dev_password

# Database — MIGRATIONS connect with the table-owning superuser instead.
# Never used by the running app, only by `npm run migration:*`.
# Compose overrides the host/port for the migration container as well.
MIGRATION_DB_USERNAME=postgres
MIGRATION_DB_PASSWORD=postgres

# Pool — max connections per app instance, and how long a request waits
# for one before failing with 503.
DB_POOL_MAX=20
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Redis (rate limiting)
# These host/port values are for running the backend directly on your machine.
# Docker Compose overrides them with redis:6379 inside the Compose network.
REDIS_HOST=localhost
REDIS_PORT=6381
