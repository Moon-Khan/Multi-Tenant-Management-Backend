# App
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database — the RUNNING APP connects with this (non-owner, RLS-subject) role.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=multitenant
DB_USERNAME=app_runtime
DB_PASSWORD=app_runtime_dev_password

# Database — MIGRATIONS connect with the table-owning superuser instead.
# Never used by the running app, only by `npm run migration:*`.
MIGRATION_DB_USERNAME=postgres
MIGRATION_DB_PASSWORD=postgres

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Redis (rate limiting, wired up in Week 3)
REDIS_HOST=localhost
REDIS_PORT=6381
